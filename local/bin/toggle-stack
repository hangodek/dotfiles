#!/bin/bash
# Smart toggle between Stacked (tab) and Split (side-by-side) for the active window.
# - If active window is part of a multi-window stack (>1 tabs): pops out into a side-by-side split tile.
# - If active window is standalone (<=1 tab): merges with adjacent window to form a combined stack.

set -euo pipefail

active=$(hyprctl activewindow -j 2>/dev/null || true)
[[ -n "$active" ]] || exit 0

addr=$(echo "$active" | jq -r '.address // empty')
[[ -n "$addr" ]] || exit 0

grouped_json=$(echo "$active" | jq -c '.grouped // []')
grouped_len=$(echo "$grouped_json" | jq 'length')

if [[ "$grouped_len" -gt 1 ]]; then
  # Pop out of the multi-window stack into a side-by-side split tile
  hyprctl dispatch "hl.dsp.window.move({ out_of_group = true })" > /dev/null
else
  # Standalone window (0 or 1 tab): merge with adjacent neighbor window into a stack

  # 1. Try direct move into an existing group on left, right, up, down
  if hyprctl dispatch "hl.dsp.window.move({ into_group = \"l\" })" > /dev/null 2>&1; then
    exit 0
  fi
  if hyprctl dispatch "hl.dsp.window.move({ into_group = \"r\" })" > /dev/null 2>&1; then
    exit 0
  fi
  if hyprctl dispatch "hl.dsp.window.move({ into_group = \"u\" })" > /dev/null 2>&1; then
    exit 0
  fi
  if hyprctl dispatch "hl.dsp.window.move({ into_group = \"d\" })" > /dev/null 2>&1; then
    exit 0
  fi

  # 2. If neighbor is not yet a group, initialize group on neighbor and merge
  for dir in l r u d; do
    opp=""
    case "$dir" in
      l) opp="r" ;;
      r) opp="l" ;;
      u) opp="d" ;;
      d) opp="u" ;;
    esac

    # Try moving focus to neighbor in this direction
    orig_addr=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')
    hyprctl dispatch "hl.dsp.focus({ direction = \"$dir\" })" > /dev/null 2>&1 || true
    new_addr=$(hyprctl activewindow -j 2>/dev/null | jq -r '.address // empty')

    # If focus successfully moved to a different neighbor window:
    if [[ -n "$new_addr" && "$new_addr" != "$orig_addr" ]]; then
      # Make neighbor a group container
      hyprctl dispatch "hl.dsp.group.toggle()" > /dev/null 2>&1 || true
      # Return focus to original window
      hyprctl dispatch "hl.dsp.focus({ direction = \"$opp\" })" > /dev/null 2>&1 || true
      # Move original window into neighbor's new group
      if hyprctl dispatch "hl.dsp.window.move({ into_group = \"$dir\" })" > /dev/null 2>&1; then
        exit 0
      fi
    fi
  done

  # 3. Fallback: if no neighbor window exists on workspace, toggle group mode on self
  hyprctl dispatch "hl.dsp.group.toggle()" > /dev/null 2>&1 || true
fi
