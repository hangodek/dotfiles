#!/bin/bash
# Query or configure the default boot kernel in Omarchy & Limine Bootloader
# Usage:
#   omarchy-default-kernel          # Prints active default kernel (e.g. cachyos, stock)
#   omarchy-default-kernel cachyos  # Sets CachyOS (BORE) as default boot kernel
#   omarchy-default-kernel stock    # Sets Stock Arch Linux as default boot kernel

set -euo pipefail

DEFAULT_LIMINE="/etc/default/limine"
STATE_FILE="$HOME/.config/omarchy/defaults/kernel"

get_current() {
  if [[ -f "$DEFAULT_LIMINE" ]] && grep -q 'BOOT_ORDER=".*cachyos' "$DEFAULT_LIMINE" 2>/dev/null; then
    echo "cachyos"
  elif [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo "stock"
  fi
}

if [[ $# -eq 0 ]]; then
  get_current
  exit 0
fi

target="$1"
mkdir -p "$(dirname "$STATE_FILE")"

set_boot_order() {
  local order="$1"
  if sudo grep -q '^BOOT_ORDER=' "$DEFAULT_LIMINE" 2>/dev/null; then
    sudo sed -i "s|^BOOT_ORDER=.*|BOOT_ORDER=\"$order\"|" "$DEFAULT_LIMINE"
  else
    echo "BOOT_ORDER=\"$order\"" | sudo tee -a "$DEFAULT_LIMINE" >/dev/null
  fi
}

case "$target" in
  cachyos)
    echo "Configuring Limine bootloader for CachyOS (BORE)..."
    set_boot_order "*cachyos*, *, *fallback, Snapshots"
    echo "cachyos" > "$STATE_FILE"
    sudo limine-snapper-sync || sudo omarchy-refresh-limine || true
    echo "Successfully set CachyOS (BORE) as the first default boot option in Limine."
    ;;
  stock | default)
    echo "Configuring Limine bootloader for Stock Arch Linux..."
    set_boot_order "*linux.efi*, *cachyos*, *fallback, Snapshots"
    echo "stock" > "$STATE_FILE"
    sudo limine-snapper-sync || sudo omarchy-refresh-limine || true
    echo "Successfully set Stock Arch Linux as the first default boot option in Limine."
    ;;
  lts)
    echo "Configuring Limine bootloader for LTS Linux..."
    set_boot_order "*lts*, *, *fallback, Snapshots"
    echo "lts" > "$STATE_FILE"
    sudo limine-snapper-sync || sudo omarchy-refresh-limine || true
    echo "Successfully set Arch Linux (LTS) as the first default boot option in Limine."
    ;;
  *)
    echo "Unknown kernel target: $target" >&2
    echo "Usage: $0 [cachyos|stock|lts]" >&2
    exit 1
    ;;
esac
