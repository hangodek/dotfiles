#!/bin/bash
# Query or configure the default boot kernel in Omarchy & Limine Bootloader
# Usage:
#   omarchy-default-kernel          # Prints active default kernel (e.g. cachyos, stock)
#   omarchy-default-kernel cachyos  # Sets CachyOS (BORE) as default boot kernel
#   omarchy-default-kernel stock    # Sets Stock Arch Linux as default boot kernel

set -euo pipefail

STATE_FILE="$HOME/.config/omarchy/defaults/kernel"
SYSTEM_STATE_FILE="/etc/omarchy/default-kernel"
POST_HOOK="/etc/boot/hooks/post.d/95-preserve-default-kernel.sh"
LIMINE_CONF="/boot/limine.conf"

get_current() {
  if [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  elif [[ -f "$SYSTEM_STATE_FILE" ]]; then
    cat "$SYSTEM_STATE_FILE"
  else
    echo "cachyos"
  fi
}

if [[ $# -eq 0 ]]; then
  get_current
  exit 0
fi

target="$1"
mkdir -p "$(dirname "$STATE_FILE")"

apply_default_to_limine() {
  local kernel_name="$1"
  local target_pattern=""

  case "$kernel_name" in
    cachyos | bore-lto | bore)
      target_pattern="//linux-cachyos-bore-lto"
      ;;
    cachyos-stock)
      target_pattern="//linux-cachyos"
      ;;
    stock | default)
      target_pattern="//linux"
      ;;
    lts)
      target_pattern="//linux-lts"
      ;;
    *)
      echo "Unknown kernel: $kernel_name" >&2
      return 1
      ;;
  esac

  if [[ ! -f "$LIMINE_CONF" ]]; then
    return 0
  fi

  # Calculate 1-based entry index in limine.conf
  local entry_idx
  entry_idx=$(grep -E '^\s*(\/\+|\/\/)' "$LIMINE_CONF" | grep -n "$target_pattern" | head -n 1 | cut -d: -f1 || true)
  if [[ -z "$entry_idx" && "$kernel_name" =~ cachyos ]]; then
    entry_idx=$(grep -E '^\s*(\/\+|\/\/)' "$LIMINE_CONF" | grep -n "//linux-cachyos" | head -n 1 | cut -d: -f1 || true)
  fi

  if [[ -n "$entry_idx" ]]; then
    sudo sed -i "s/^default_entry:.*/default_entry: $entry_idx/" "$LIMINE_CONF"
    echo "Limine default_entry set to $entry_idx ($target_pattern)"
  fi
}

install_post_hook() {
  sudo mkdir -p /etc/omarchy /etc/boot/hooks/post.d
  echo "$target" | sudo tee "$SYSTEM_STATE_FILE" >/dev/null

  cat << 'HOOK_EOF' | sudo tee "$POST_HOOK" >/dev/null
#!/bin/bash
# Automatically maintain default boot kernel in /boot/limine.conf after updates
set -euo pipefail

LIMINE_CONF="/boot/limine.conf"
SYSTEM_STATE_FILE="/etc/omarchy/default-kernel"

if [[ ! -f "$LIMINE_CONF" || ! -f "$SYSTEM_STATE_FILE" ]]; then
  exit 0
fi

target=$(cat "$SYSTEM_STATE_FILE" 2>/dev/null || echo "cachyos")
pattern=""

case "$target" in
  cachyos|bore-lto|bore) pattern="//linux-cachyos-bore-lto" ;;
  cachyos-stock) pattern="//linux-cachyos" ;;
  stock|default) pattern="//linux" ;;
  lts) pattern="//linux-lts" ;;
  *) pattern="//linux-cachyos-bore-lto" ;;
esac

entry_idx=$(grep -E '^\s*(\/\+|\/\/)' "$LIMINE_CONF" | grep -n "$pattern" | head -n 1 | cut -d: -f1 || true)
if [[ -z "$entry_idx" && "$target" =~ cachyos ]]; then
  entry_idx=$(grep -E '^\s*(\/\+|\/\/)' "$LIMINE_CONF" | grep -n "//linux-cachyos" | head -n 1 | cut -d: -f1 || true)
fi
if [[ -n "$entry_idx" ]]; then
  sed -i "s/^default_entry:.*/default_entry: $entry_idx/" "$LIMINE_CONF"
fi
HOOK_EOF
  sudo chmod +x "$POST_HOOK"
}

update_limine_boot_order() {
  local target_pattern="$1"
  local order=""

  case "$target_pattern" in
    cachyos|bore-lto|bore)
      order="*cachyos-bore-lto*, *cachyos*, *, *fallback, Snapshots"
      ;;
    stock|default)
      order="*linux.efi*, *linux*, *, *fallback, Snapshots"
      ;;
    lts)
      order="*linux-lts*, *, *fallback, Snapshots"
      ;;
  esac

  if [[ -n "$order" ]]; then
    for conf_file in /etc/default/limine /etc/limine-entry-tool.conf /etc/limine-entry-tool.d/omarchy-defaults.conf; do
      if [[ -f "$conf_file" ]]; then
        if grep -q '^BOOT_ORDER=' "$conf_file" 2>/dev/null; then
          sudo sed -i "s|^BOOT_ORDER=.*|BOOT_ORDER=\"$order\"|" "$conf_file" 2>/dev/null || true
        else
          echo "BOOT_ORDER=\"$order\"" | sudo tee -a "$conf_file" >/dev/null 2>&1 || true
        fi
      fi
    done
    sudo limine-snapper-sync >/dev/null 2>&1 || sudo limine-entry-tool >/dev/null 2>&1 || true
  fi
}

case "$target" in
  cachyos | bore-lto | bore)
    echo "cachyos" > "$STATE_FILE"
    install_post_hook
    update_limine_boot_order cachyos
    apply_default_to_limine cachyos
    echo "Default boot kernel set to: CachyOS BORE + LTO [Persistent across all updates]"
    ;;
  stock | default)
    echo "stock" > "$STATE_FILE"
    install_post_hook
    update_limine_boot_order stock
    apply_default_to_limine stock
    echo "Default boot kernel set to: Arch Linux (Stock) [Persistent across all updates]"
    ;;
  lts)
    echo "lts" > "$STATE_FILE"
    install_post_hook
    update_limine_boot_order lts
    apply_default_to_limine lts
    echo "Default boot kernel set to: Arch Linux (LTS) [Persistent across all updates]"
    ;;
  *)
    echo "Unknown kernel target: $target" >&2
    echo "Usage: $0 [cachyos|bore-lto|stock|lts]" >&2
    exit 1
    ;;
esac
