#!/bin/bash
# Alt+F: Smart toggle for centered scratchpad (special:center).
# - If scratchpad contains windows: toggles visibility.
# - If scratchpad is empty: brings up the Apps Menu on the current workspace,
#   and when an app is launched, automatically moves it into special:center,
#   opens the scratchpad, and groups it into a stack.
# - If user presses Esc / cancels the menu: current workspace remains 100% untouched.

set -euo pipefail

SPECIAL="center"

# Count windows currently residing in special:center
special_windows=$(hyprctl clients -j 2>/dev/null \
  | jq "[.[] | select(.workspace.name == \"special:$SPECIAL\")] | length" 2>/dev/null || echo 0)

if [[ "$special_windows" -gt 0 ]]; then
  # Scratchpad has active windows -> standard toggle
  hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$SPECIAL\")" > /dev/null
else
  # Scratchpad is empty:
  # Snapshot existing window addresses before opening menu
  before_addrs=$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | sort)

  # Start background watcher to catch the newly launched app
  (
    for (( i=0; i<80; i++ )); do
      sleep 0.1
      after_clients=$(hyprctl clients -j 2>/dev/null || true)
      [[ -n "$after_clients" ]] || continue

      # Find any newly created window address that wasn't present before
      new_addr=$(echo "$after_clients" | jq -r '.[].address' | sort | comm -13 <(echo "$before_addrs") - | head -n1 || true)

      if [[ -n "$new_addr" ]]; then
        # A new app was launched! Move it into special:center and show the scratchpad
        hyprctl dispatch "hl.dsp.window.move({ window = \"address:$new_addr\", workspace = \"special:$SPECIAL\" })" > /dev/null 2>&1 || true
        hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$SPECIAL\")" > /dev/null 2>&1 || true
        hyprctl dispatch "hl.dsp.group.toggle()" > /dev/null 2>&1 || true
        break
      fi
    done
  ) >/dev/null 2>&1 &

  # Open the Omarchy Apps Menu
  omarchy-menu toggle apps > /dev/null 2>&1 || true
fi
