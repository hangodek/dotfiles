#!/bin/bash
# Multi-Deck Scratchpad Manager for Hyprland.
# Each deck is an independent floating workspace (special:deck_1, special:deck_2, ...)
# allowing full tiling inside (e.g. Super+Return opens terminals side-by-side)
# with smooth vertical switching (Super+Up / Super+Down) between decks.

set -euo pipefail

action="${1:-toggle}"

# State directory to remember active deck
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/scratchpad"
STATE_FILE="$STATE_DIR/active_deck"
mkdir -p "$STATE_DIR"

get_active_decks() {
  hyprctl clients -j 2>/dev/null \
    | jq -r '[.[] | .workspace.name | select(startswith("special:deck_") or . == "special:center")] | unique | .[]' 2>/dev/null \
    | sort -V || true
}

get_visible_deck() {
  local mon
  mon=$(hyprctl monitors -j 2>/dev/null || echo "[]")
  local sp
  sp=$(echo "$mon" | jq -r '(.[] | select(.focused == true) | .specialWorkspace.name // empty), (.[0].specialWorkspace.name // empty)' 2>/dev/null | grep -E '^special:(deck_|center)' | head -n1 || true)
  if [[ -z "$sp" ]]; then
    local act_ws
    act_ws=$(hyprctl activewindow -j 2>/dev/null | jq -r '.workspace.name // empty' 2>/dev/null || true)
    if [[ "$act_ws" =~ ^special:(deck_|center) ]]; then
      sp="$act_ws"
    fi
  fi
  echo "$sp"
}

get_saved_deck() {
  if [[ -r "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo "deck_1"
  fi
}

save_active_deck() {
  local deck="$1"
  echo "$deck" > "$STATE_FILE"
}

unfullscreen_window() {
  local addr="$1"
  [[ -n "$addr" ]] || return 0
  local fs_state
  fs_state=$(hyprctl clients -j 2>/dev/null | jq -r ".[] | select(.address == \"$addr\") | .fullscreen // 0" 2>/dev/null || echo 0)
  if [[ "$fs_state" -eq 1 ]]; then
    hyprctl dispatch "hl.dsp.window.fullscreen({ window = \"address:$addr\", mode = \"maximized\" })" > /dev/null 2>&1 || true
  elif [[ "$fs_state" -eq 2 ]]; then
    hyprctl dispatch "hl.dsp.window.fullscreen({ window = \"address:$addr\", mode = \"fullscreen\" })" > /dev/null 2>&1 || true
  fi
}

cmd_toggle() {
  local vis
  vis=$(get_visible_deck)

  if [[ -n "$vis" ]]; then
    # Currently open -> hide it
    local deck_name="${vis#special:}"
    save_active_deck "$deck_name"
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$deck_name\")" > /dev/null
  else
    # Currently hidden -> open last active deck or create new
    mapfile -t decks < <(get_active_decks)
    if [[ ${#decks[@]} -gt 0 ]]; then
      local target_deck
      target_deck=$(get_saved_deck)
      # Validate target_deck exists in active decks, else pick first
      local found=0
      for d in "${decks[@]}"; do
        if [[ "$d" == "special:$target_deck" || "$d" == "$target_deck" ]]; then
          found=1
          break
        fi
      done
      if [[ $found -eq 0 ]]; then
        target_deck="${decks[0]#special:}"
      fi
      save_active_deck "$target_deck"
      hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$target_deck\")" > /dev/null
      local target_addr
      target_addr=$(hyprctl clients -j 2>/dev/null | jq -r "[.[] | select(.workspace.name == \"special:$target_deck\")] | .[0].address // empty")
      if [[ -n "$target_addr" ]]; then
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$target_addr\" })" > /dev/null 2>&1 || true
      fi
    else
      # No decks exist -> create Deck 1
      cmd_new "deck_1"
    fi
  fi
}

cmd_new() {
  local requested_deck="${1:-}"

  if [[ -z "$requested_deck" ]]; then
    # Find next available deck number
    mapfile -t active_decks < <(get_active_decks)
    local max_num=0
    for d in "${active_decks[@]}"; do
      local name="${d#special:}"
      if [[ "$name" =~ ^deck_([0-9]+)$ ]]; then
        local num="${BASH_REMATCH[1]}"
        if (( num > max_num )); then
          max_num=$num
        fi
      fi
    done
    requested_deck="deck_$(( max_num + 1 ))"
  fi

  # Snapshot existing window addresses and main window maximization state
  local active_main_addr=""
  local active_main_fs=0
  local active_main
  active_main=$(hyprctl activewindow -j 2>/dev/null || true)
  if [[ -n "$active_main" ]]; then
    active_main_addr=$(echo "$active_main" | jq -r '.address // empty')
    active_main_fs=$(echo "$active_main" | jq -r '.fullscreen // 0')
  fi

  local before_addrs
  before_addrs=$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | sort)

  # 1. Immediately toggle the target deck visible so the new window spawns directly into the scratchpad
  local vis
  vis=$(get_visible_deck)
  if [[ "$vis" != "special:$requested_deck" ]]; then
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$requested_deck\")" > /dev/null 2>&1 || true
  fi
  save_active_deck "$requested_deck"

  # Kill any previous watcher
  local pidfile="/tmp/scratchpad_watcher.pid"
  if [[ -f "$pidfile" ]]; then
    kill "$(cat "$pidfile")" 2>/dev/null || true
    rm -f "$pidfile"
  fi

  # Start background watcher to catch and move the launched app into the target scratchpad deck
  (
    echo $$ > "$pidfile"
    local window_caught=0
    for (( i=0; i<50; i++ )); do
      sleep 0.1
      local after_clients
      after_clients=$(hyprctl clients -j 2>/dev/null || true)
      [[ -n "$after_clients" ]] || continue

      local new_addr
      new_addr=$(echo "$after_clients" | jq -r '.[].address' | sort | comm -13 <(echo "$before_addrs") - | head -n1 || true)

      if [[ -n "$new_addr" ]]; then
        window_caught=1

        # 1. Focus the new window
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$new_addr\" })" > /dev/null 2>&1 || true

        # 2. Move it to the target special deck
        hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:$requested_deck\", follow = true })" > /dev/null 2>&1 || true

        # 3. Ensure deck is visible
        local vis
        vis=$(get_visible_deck)
        if [[ "$vis" != "special:$requested_deck" ]]; then
          hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$requested_deck\")" > /dev/null 2>&1 || true
        fi

        echo "$requested_deck" > "$STATE_FILE"
        break
      fi
    done

    # If menu was dismissed without launching any app and the deck is empty, dismiss the overlay
    if [[ $window_caught -eq 0 ]]; then
      local count_in_deck
      count_in_deck=$(hyprctl clients -j 2>/dev/null | jq "[.[] | select(.workspace.name == \"special:$requested_deck\")] | length" 2>/dev/null || echo 0)
      if [[ "$count_in_deck" -eq 0 ]]; then
        local current_vis
        current_vis=$(get_visible_deck)
        if [[ "$current_vis" == "special:$requested_deck" ]]; then
          hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$requested_deck\")" > /dev/null 2>&1 || true
        fi
      fi
    fi
    rm -f "$pidfile"
  ) >/dev/null 2>&1 &

  # Open Omarchy Apps Menu
  omarchy-menu toggle apps > /dev/null 2>&1 || true
}

cmd_next() {
  local vis
  vis=$(get_visible_deck)
  [[ -n "$vis" ]] || exit 0

  mapfile -t decks < <(get_active_decks)
  local count=${#decks[@]}
  (( count > 1 )) || exit 0

  local curr_idx=0
  for (( i=0; i<count; i++ )); do
    if [[ "${decks[i]}" == "$vis" ]]; then
      curr_idx=$i
      break
    fi
  done

  local next_idx=$(( (curr_idx + 1) % count ))
  local next_deck="${decks[next_idx]#special:}"
  save_active_deck "$next_deck"
  hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$next_deck\")" > /dev/null
  local target_addr
  target_addr=$(hyprctl clients -j 2>/dev/null | jq -r "[.[] | select(.workspace.name == \"special:$next_deck\")] | .[0].address // empty")
  if [[ -n "$target_addr" ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$target_addr\" })" > /dev/null 2>&1 || true
  fi
}

cmd_prev() {
  local vis
  vis=$(get_visible_deck)
  [[ -n "$vis" ]] || exit 0

  mapfile -t decks < <(get_active_decks)
  local count=${#decks[@]}
  (( count > 1 )) || exit 0

  local curr_idx=0
  for (( i=0; i<count; i++ )); do
    if [[ "${decks[i]}" == "$vis" ]]; then
      curr_idx=$i
      break
    fi
  done

  local prev_idx=$(( (curr_idx - 1 + count) % count ))
  local prev_deck="${decks[prev_idx]#special:}"
  save_active_deck "$prev_deck"
  hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$prev_deck\")" > /dev/null
  local target_addr
  target_addr=$(hyprctl clients -j 2>/dev/null | jq -r "[.[] | select(.workspace.name == \"special:$prev_deck\")] | .[0].address // empty")
  if [[ -n "$target_addr" ]]; then
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$target_addr\" })" > /dev/null 2>&1 || true
  fi
}

cmd_close() {
  hyprctl dispatch "hl.dsp.window.close()" > /dev/null 2>&1 || true
}

cmd_eject() {
  local active
  active=$(hyprctl activewindow -j 2>/dev/null || true)
  [[ -n "$active" ]] || exit 0

  local active_ws
  active_ws=$(echo "$active" | jq -r '.workspace.name // empty')
  local active_addr
  active_addr=$(echo "$active" | jq -r '.address // empty')
  [[ -n "$active_addr" ]] || exit 0

  if [[ "$active_ws" =~ ^special:(deck_[0-9]+|center)$ ]]; then
    # In Scratchpad Deck -> eject to active main workspace
    local current_main
    current_main=$(hyprctl monitors -j 2>/dev/null \
      | jq -r '.[0].activeWorkspace.name // "1"' 2>/dev/null || echo "1")

    # 1. Move active window to current main workspace
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"$current_main\", follow = true })" > /dev/null 2>&1 || true

    # 2. Immediately close / dismiss visible scratchpad overlay
    local vis
    vis=$(get_visible_deck)
    if [[ -n "$vis" ]]; then
      local deck_name="${vis#special:}"
      hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$deck_name\")" > /dev/null 2>&1 || true
    fi

    # 3. Focus the ejected window on the main workspace and ensure unmaximized
    hyprctl dispatch "hl.dsp.focus({ window = \"address:$active_addr\" })" > /dev/null 2>&1 || true
    unfullscreen_window "$active_addr"
  else
    # In Main Workspace -> move into current active deck
    local target_deck
    target_deck=$(get_saved_deck)

    # Ensure unfullscreened before/after moving into deck
    unfullscreen_window "$active_addr"
    hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:$target_deck\", follow = true })" > /dev/null 2>&1 || true

    # Show deck if not already visible
    local vis
    vis=$(get_visible_deck)
    if [[ "$vis" != "special:$target_deck" ]]; then
      hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$target_deck\")" > /dev/null 2>&1 || true
    fi
  fi
}

cmd_launch() {
  shift || true
  local target_deck
  target_deck=$(get_saved_deck)

  # Snapshot existing window addresses and main window maximization state
  local active_main_addr=""
  local active_main_fs=0
  local active_main
  active_main=$(hyprctl activewindow -j 2>/dev/null || true)
  if [[ -n "$active_main" ]]; then
    active_main_addr=$(echo "$active_main" | jq -r '.address // empty')
    active_main_fs=$(echo "$active_main" | jq -r '.fullscreen // 0')
  fi

  local before_addrs
  before_addrs=$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | sort)

  # Kill any previous watcher
  local pidfile="/tmp/scratchpad_launch_watcher.pid"
  if [[ -f "$pidfile" ]]; then
    kill "$(cat "$pidfile")" 2>/dev/null || true
    rm -f "$pidfile"
  fi

  # Start background watcher to catch and move the launched window into scratchpad
  (
    echo $$ > "$pidfile"
    for (( i=0; i<30; i++ )); do
      sleep 0.1
      local after_clients
      after_clients=$(hyprctl clients -j 2>/dev/null || true)
      [[ -n "$after_clients" ]] || continue

      local new_addr
      new_addr=$(echo "$after_clients" | jq -r '.[].address' | sort | comm -13 <(echo "$before_addrs") - | head -n1 || true)

      if [[ -n "$new_addr" ]]; then
        # 1. Focus the new window
        hyprctl dispatch "hl.dsp.focus({ window = \"address:$new_addr\" })" > /dev/null 2>&1 || true

        # 2. Move to the target special deck
        hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:$target_deck\", follow = true })" > /dev/null 2>&1 || true

        # 3. Ensure deck is visible
        local vis
        vis=$(get_visible_deck)
        if [[ "$vis" != "special:$target_deck" ]]; then
          hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$target_deck\")" > /dev/null 2>&1 || true
        fi

        save_active_deck "$target_deck"
        break
      fi
    done
    rm -f "$pidfile"
  ) >/dev/null 2>&1 &

  # Launch the application
  exec setsid uwsm-app -- "$@"
}

case "$action" in
  toggle) cmd_toggle ;;
  new)    cmd_new ;;
  launch) cmd_launch "$@" ;;
  next)   cmd_next ;;
  prev)   cmd_prev ;;
  close)  cmd_close ;;
  eject)  cmd_eject ;;
  *)
    echo "Usage: scratchpad-deck [toggle|new|launch|next|prev|close|eject]" >&2
    exit 1
    ;;
esac
