#!/bin/bash
# Multi-Deck Scratchpad Manager for Hyprland.
# Each deck is an independent floating workspace (special:deck_1, special:deck_2, ...)
# allowing full tiling inside (e.g. Super+Return opens terminals side-by-side)
# with smooth vertical switching (Super+Up / Super+Down) between decks.

set -euo pipefail

action="${1:-toggle}"

# State directory to remember active deck
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/scratchpad"
STATE_FILE="$STATE_DIR/active_deck"
mkdir -p "$STATE_DIR"

get_active_decks() {
  hyprctl clients -j 2>/dev/null \
    | jq -r '[.[] | .workspace.name | select(startswith("special:deck_") or . == "special:center")] | unique | sort | .[]' 2>/dev/null || true
}

get_visible_deck() {
  local mon
  mon=$(hyprctl monitors -j 2>/dev/null || echo "[]")
  local sp
  sp=$(echo "$mon" | jq -r '(.[] | select(.focused == true) | .specialWorkspace.name // empty), (.[0].specialWorkspace.name // empty)' 2>/dev/null | grep -E '^special:(deck_|center)' | head -n1 || true)
  if [[ -z "$sp" ]]; then
    local act_ws
    act_ws=$(hyprctl activewindow -j 2>/dev/null | jq -r '.workspace.name // empty' 2>/dev/null || true)
    if [[ "$act_ws" =~ ^special:(deck_|center) ]]; then
      sp="$act_ws"
    fi
  fi
  echo "$sp"
}

get_saved_deck() {
  if [[ -r "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo "deck_1"
  fi
}

save_active_deck() {
  local deck="$1"
  echo "$deck" > "$STATE_FILE"
}

cmd_toggle() {
  local vis
  vis=$(get_visible_deck)

  if [[ -n "$vis" ]]; then
    # Currently open -> hide it
    local deck_name="${vis#special:}"
    save_active_deck "$deck_name"
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$deck_name\")" > /dev/null
  else
    # Currently hidden -> open last active deck or create new
    mapfile -t decks < <(get_active_decks)
    if [[ ${#decks[@]} -gt 0 ]]; then
      local target_deck
      target_deck=$(get_saved_deck)
      # Validate target_deck exists in active decks, else pick first
      local found=0
      for d in "${decks[@]}"; do
        if [[ "$d" == "special:$target_deck" || "$d" == "$target_deck" ]]; then
          found=1
          break
        fi
      done
      if [[ $found -eq 0 ]]; then
        target_deck="${decks[0]#special:}"
      fi
      save_active_deck "$target_deck"
      hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$target_deck\")" > /dev/null
    else
      # No decks exist -> create Deck 1
      cmd_new "deck_1"
    fi
  fi
}

cmd_new() {
  local requested_deck="${1:-}"

  if [[ -z "$requested_deck" ]]; then
    # Find next available deck number
    mapfile -t active_decks < <(get_active_decks)
    local max_num=0
    for d in "${active_decks[@]}"; do
      local name="${d#special:}"
      if [[ "$name" =~ ^deck_([0-9]+)$ ]]; then
        local num="${BASH_REMATCH[1]}"
        if (( num > max_num )); then
          max_num=$num
        fi
      fi
    done
    requested_deck="deck_$(( max_num + 1 ))"
  fi

  # Snapshot existing window addresses before opening launcher
  local before_addrs
  before_addrs=$(hyprctl clients -j 2>/dev/null | jq -r '.[].address' | sort)

  # Start background watcher to catch newly launched app
  (
    for (( i=0; i<80; i++ )); do
      sleep 0.1
      local after_clients
      after_clients=$(hyprctl clients -j 2>/dev/null || true)
      [[ -n "$after_clients" ]] || continue

      local new_addr
      new_addr=$(echo "$after_clients" | jq -r '.[].address' | sort | comm -13 <(echo "$before_addrs") - | head -n1 || true)

      if [[ -n "$new_addr" ]]; then
        # Move into the new special deck
        hyprctl dispatch "hl.dsp.window.move({ window = \"address:$new_addr\", workspace = \"special:$requested_deck\" })" > /dev/null 2>&1 || true

        # Ensure deck is visible
        if ! hyprctl monitors -j 2>/dev/null | jq -e '.[].specialWorkspace.name == "special:'"$requested_deck"'"' >/dev/null 2>&1; then
          hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$requested_deck\")" > /dev/null 2>&1 || true
        fi

        echo "$requested_deck" > "$STATE_FILE"
        break
      fi
    done
  ) >/dev/null 2>&1 &

  # Open Omarchy Apps Menu
  omarchy-menu toggle apps > /dev/null 2>&1 || true
}

cmd_next() {
  local vis
  vis=$(get_visible_deck)
  [[ -n "$vis" ]] || exit 0

  mapfile -t decks < <(get_active_decks)
  local count=${#decks[@]}
  (( count > 1 )) || exit 0

  local curr_idx=0
  for (( i=0; i<count; i++ )); do
    if [[ "${decks[i]}" == "$vis" ]]; then
      curr_idx=$i
      break
    fi
  done

  local next_idx=$(( (curr_idx + 1) % count ))
  local next_deck="${decks[next_idx]#special:}"
  save_active_deck "$next_deck"
  hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$next_deck\")" > /dev/null
}

cmd_prev() {
  local vis
  vis=$(get_visible_deck)
  [[ -n "$vis" ]] || exit 0

  mapfile -t decks < <(get_active_decks)
  local count=${#decks[@]}
  (( count > 1 )) || exit 0

  local curr_idx=0
  for (( i=0; i<count; i++ )); do
    if [[ "${decks[i]}" == "$vis" ]]; then
      curr_idx=$i
      break
    fi
  done

  local prev_idx=$(( (curr_idx - 1 + count) % count ))
  local prev_deck="${decks[prev_idx]#special:}"
  save_active_deck "$prev_deck"
  hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$prev_deck\")" > /dev/null
}

cmd_close() {
  local active
  active=$(hyprctl activewindow -j 2>/dev/null || true)
  [[ -n "$active" ]] || exit 0

  local active_ws
  active_ws=$(echo "$active" | jq -r '.workspace.name // empty')
  local active_addr
  active_addr=$(echo "$active" | jq -r '.address // empty')

  if [[ "$active_ws" =~ ^special:(deck_[0-9]+|center)$ ]]; then
    # In Scratchpad Deck:
    local remaining_in_this_deck
    remaining_in_this_deck=$(hyprctl clients -j 2>/dev/null \
      | jq "[.[] | select(.workspace.name == \"$active_ws\")] | length" 2>/dev/null || echo 1)

    if [[ "$remaining_in_this_deck" -eq 1 ]]; then
      # This is the LAST window in this deck!
      mapfile -t all_decks < <(get_active_decks)
      local other_decks=()
      for d in "${all_decks[@]}"; do
        if [[ "$d" != "$active_ws" ]]; then
          other_decks+=("${d#special:}")
        fi
      done

      # Close active window first
      hyprctl dispatch "hl.dsp.window.close({ window = \"address:$active_addr\" })" > /dev/null 2>&1 || true

      if [[ ${#other_decks[@]} -gt 0 ]]; then
        # Switch to previous/nearest remaining deck so overlay stays open
        local target_deck="${other_decks[-1]}"
        save_active_deck "$target_deck"
        sleep 0.05
        hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$target_deck\")" > /dev/null 2>&1 || true
      fi
      exit 0
    fi
  fi

  # Standard window close
  hyprctl dispatch "hl.dsp.window.close({ window = \"address:$active_addr\" })" > /dev/null 2>&1 || true
}

cmd_eject() {
  local active
  active=$(hyprctl activewindow -j 2>/dev/null || true)
  [[ -n "$active" ]] || exit 0

  local active_ws
  active_ws=$(echo "$active" | jq -r '.workspace.name // empty')
  local active_addr
  active_addr=$(echo "$active" | jq -r '.address // empty')
  [[ -n "$active_addr" ]] || exit 0

  if [[ "$active_ws" =~ ^special:(deck_[0-9]+|center)$ ]]; then
    # In Scratchpad Deck -> eject to active main workspace
    local current_main
    current_main=$(hyprctl monitors -j 2>/dev/null \
      | jq -r '.[0].activeWorkspace.name // "1"' 2>/dev/null || echo "1")

    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$active_addr\", workspace = \"$current_main\" })" > /dev/null

    # Check if current deck is now empty
    local remaining
    remaining=$(hyprctl clients -j 2>/dev/null \
      | jq "[.[] | select(.workspace.name == \"$active_ws\")] | length" 2>/dev/null || echo 0)

    if [[ "$remaining" -eq 0 ]]; then
      # Find if other decks exist
      mapfile -t remaining_decks < <(get_active_decks)
      if [[ ${#remaining_decks[@]} -gt 0 ]]; then
        local next_deck="${remaining_decks[0]#special:}"
        save_active_deck "$next_deck"
        hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$next_deck\")" > /dev/null 2>&1 || true
      else
        # Close special overlay
        local deck_name="${active_ws#special:}"
        hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$deck_name\")" > /dev/null 2>&1 || true
      fi
    fi
  else
    # In Main Workspace -> move into current active deck
    local target_deck
    target_deck=$(get_saved_deck)

    hyprctl dispatch "hl.dsp.window.move({ window = \"address:$active_addr\", workspace = \"special:$target_deck\" })" > /dev/null

    # Show deck if not already visible
    local vis
    vis=$(get_visible_deck)
    if [[ "$vis" != "special:$target_deck" ]]; then
      hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$target_deck\")" > /dev/null
    fi
  fi
}

case "$action" in
  toggle) cmd_toggle ;;
  new)    cmd_new ;;
  next)   cmd_next ;;
  prev)   cmd_prev ;;
  close)  cmd_close ;;
  eject)  cmd_eject ;;
  *)
    echo "Usage: scratchpad-deck [toggle|new|next|prev|close|eject]" >&2
    exit 1
    ;;
esac
