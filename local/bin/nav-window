#!/bin/bash
# Smart window navigation:
# - Inside a Scratchpad Deck (special:deck_*):
#   - Super+Up / Super+Down slides vertically between Scratchpad Decks.
#   - Super+Left / Super+Right navigates horizontally between side-by-side windows within the current deck.
# - Across normal main workspaces:
#   - Super+Up/Down/Left/Right focuses directionally across tiled windows.

set -euo pipefail

dir=${1:-left}

active=$(hyprctl activewindow -j 2>/dev/null || true)
[[ -n "$active" ]] || exit 0

ws=$(echo "$active" | jq -r '.workspace.name // empty')

if [[ "$ws" =~ ^special:(deck_[0-9]+|center)$ ]]; then
  # Inside a Scratchpad Deck:
  case "$dir" in
    up|u)
      # Switch to previous deck
      scratchpad-deck prev
      exit 0
      ;;
    down|d)
      # Switch to next deck
      scratchpad-deck next
      exit 0
      ;;
    left|l)
      # Focus left window in this deck
      hyprctl dispatch "hl.dsp.focus({ direction = \"l\" })" > /dev/null
      exit 0
      ;;
    right|r)
      # Focus right window in this deck
      hyprctl dispatch "hl.dsp.focus({ direction = \"r\" })" > /dev/null
      exit 0
      ;;
  esac
fi

# Main Workspace: Standard directional focus
case "$dir" in
  up|u)    hyprctl dispatch "hl.dsp.focus({ direction = \"u\" })" > /dev/null ;;
  down|d)  hyprctl dispatch "hl.dsp.focus({ direction = \"d\" })" > /dev/null ;;
  left|l)  hyprctl dispatch "hl.dsp.focus({ direction = \"l\" })" > /dev/null ;;
  right|r) hyprctl dispatch "hl.dsp.focus({ direction = \"r\" })" > /dev/null ;;
esac
