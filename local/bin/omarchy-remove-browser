#!/bin/bash
# Wrapper around omarchy-remove-browser with LibreWolf support

if [[ "${1:-}" == "librewolf" ]]; then
  echo "Removing LibreWolf..."
  current_browser=$(env -u BROWSER xdg-settings get default-web-browser)
  if [[ "$current_browser" == "librewolf.desktop" ]]; then
    if omarchy-cmd-present chromium; then
      env -u BROWSER xdg-settings set default-web-browser chromium.desktop || true
    fi
  fi
  omarchy-pkg-drop librewolf
  exit 0
fi

exec /usr/share/omarchy/bin/omarchy-remove-browser "$@"
