#!/usr/bin/env python3
"""
Tactile Universal Auto-Fill & Smart Auto-Collapse Engine
Monitors Hyprland window creation, focus, and destruction events via socket2.

Features:
1. Standard Tiling Mode:
   If windows on the workspace are standard TILED (floating: false), this daemon
   does NOTHING, letting Hyprland do its native dwindle tiling.
2. Tactile Floating Mode:
   - When a new window opens:
     a) If there are unoccupied grid cells -> snaps new window into the unoccupied gap (RIGHT).
     b) If grid is full -> splits the currently focused window following a strict,
        guaranteed alternating sequence: Right -> Bottom -> Right -> Bottom -> Right.
   - When a window closes (Universal N-Window Sibling Collapse):
     a) Automatically detects the empty void left by the closed window.
     b) Expands the adjacent sibling window (Horizontal or Vertical) to fill the empty space.
     c) If only 1 window remains -> expands to 100% Full Screen canvas.
"""

import sys
import os
import json
import socket
import subprocess
import time

# Cache of last known window geometries: { addr.lower(): (x, y, w, h, ws_id) }
last_known_geometry = {}
# Track currently focused window address
last_focused_window_addr = None
# Track previous split direction for each window: { addr.lower(): 'right' | 'bottom' }
split_direction_history = {}


def get_hypr_socket2():
    his = os.getenv('HYPRLAND_INSTANCE_SIGNATURE')
    if not his:
        return None
    
    runtime_dir = os.getenv('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    path = os.path.join(runtime_dir, 'hypr', his, '.socket2.sock')
    return path if os.path.exists(path) else None


def load_config():
    config_paths = [
        os.path.expanduser('~/.config/tactile/config.json'),
        os.path.expanduser('~/dotfiles/config/tactile/config.json'),
    ]
    for p in config_paths:
        if os.path.isfile(p):
            try:
                with open(p, 'r') as f:
                    return json.load(f)
            except Exception:
                pass

    return {
        "grid": { "rows": 2, "cols": 3 },
        "col_weights": [1.0, 1.0, 1.0],
        "row_weights": [1.0, 1.0],
        "gaps": { "outer": 12, "inner": 8, "top_bar": 35 }
    }


def get_active_clients_and_monitor():
    global last_focused_window_addr
    try:
        clients = json.loads(subprocess.check_output(['hyprctl', 'clients', '-j'], text=True))
        monitors = json.loads(subprocess.check_output(['hyprctl', 'monitors', '-j'], text=True))
        focused_mon = next((m for m in monitors if m.get('focused')), monitors[0] if monitors else None)
        
        for c in clients:
            addr = c.get('address', '').lower()
            if addr and c.get('floating') is True:
                at = c.get('at', [0, 0])
                size = c.get('size', [0, 0])
                ws_id = c.get('workspace', {}).get('id')
                last_known_geometry[addr] = (at[0], at[1], size[0], size[1], ws_id)
            if c.get('focusHistoryID') == 0:
                last_focused_window_addr = addr

        return clients, focused_mon
    except Exception:
        return [], None


def compute_dimension_coords(canvas_start, canvas_total, inner, weights, idx1, idx2):
    num = len(weights)
    sum_w = sum(weights)
    if sum_w <= 0:
        sum_w = num

    net_space = canvas_total - (num - 1) * inner
    sizes = []
    allocated = 0
    for w in weights:
        s = int((w / sum_w) * net_space)
        sizes.append(s)
        allocated += s
    sizes[-1] += (net_space - allocated)

    starts = []
    curr = canvas_start
    for s in sizes:
        starts.append(curr)
        curr += s + inner

    target_start = starts[idx1]
    target_size = sum(sizes[idx1:idx2 + 1]) + (idx2 - idx1) * inner

    return target_start, target_size, sizes, starts


def map_window_to_cells(win, mon, cfg):
    """Determine which grid cells a floating window currently occupies."""
    if not win or not mon:
        return []

    mon_w = mon.get('width', 1920)
    mon_h = mon.get('height', 1080)
    scale = mon.get('scale', 1.0)
    mon_x = mon.get('x', 0)
    mon_y = mon.get('y', 0)

    scaled_w = int(mon_w / scale)
    scaled_h = int(mon_h / scale)

    gaps = cfg.get('gaps', {})
    outer = gaps.get('outer', 12)
    inner = gaps.get('inner', 8)
    top_bar = gaps.get('top_bar', 35)

    canvas_x = mon_x + outer
    canvas_y = mon_y + top_bar + outer
    canvas_w = scaled_w - (2 * outer)
    canvas_h = scaled_h - top_bar - (2 * outer)

    grid = cfg.get('grid', {})
    cols = grid.get('cols', 3)
    rows = grid.get('rows', 2)

    col_weights = cfg.get('col_weights', [1.0] * cols)
    while len(col_weights) < cols:
        col_weights.append(1.0)
    col_weights = col_weights[:cols]

    row_weights = cfg.get('row_weights', [1.0] * rows)
    while len(row_weights) < rows:
        row_weights.append(1.0)
    row_weights = row_weights[:rows]

    _, _, col_sizes, col_starts = compute_dimension_coords(canvas_x, canvas_w, inner, col_weights, 0, cols - 1)
    _, _, row_sizes, row_starts = compute_dimension_coords(canvas_y, canvas_h, inner, row_weights, 0, rows - 1)

    win_at = win.get('at', [0, 0])
    win_size = win.get('size', [0, 0])
    wx, wy = win_at[0], win_at[1]
    ww, wh = win_size[0], win_size[1]

    occupied = []
    for r in range(rows):
        for c in range(cols):
            cx = col_starts[c]
            cy = row_starts[r]
            cw = col_sizes[c]
            ch = row_sizes[r]

            overlap_x = max(0, min(wx + ww, cx + cw) - max(wx, cx))
            overlap_y = max(0, min(wy + wh, cy + ch) - max(wy, cy))
            
            if (overlap_x * overlap_y) > (0.30 * cw * ch):
                occupied.append((r, c))

    return occupied


def autofill_new_window(new_addr, workspace_id_or_name):
    global last_focused_window_addr, split_direction_history
    cfg = load_config()
    clients, mon = get_active_clients_and_monitor()
    if not mon:
        return

    ws_str = str(workspace_id_or_name).strip()
    existing_clients = []
    for c in clients:
        c_addr = c.get('address', '').lower()
        if c_addr == new_addr.lower():
            continue
        c_ws_name = str(c.get('workspace', {}).get('name', ''))
        c_ws_id = str(c.get('workspace', {}).get('id', ''))
        
        if (c_ws_name == ws_str or c_ws_id == ws_str) and not c.get('hidden') and c.get('mapped'):
            existing_clients.append(c)

    if not existing_clients:
        return

    # Guard: ONLY proceed if workspace has floating Tactile windows
    floating_clients = [c for c in existing_clients if c.get('floating') is True]
    if not floating_clients:
        return

    grid = cfg.get('grid', {})
    cols = grid.get('cols', 3)
    rows = grid.get('rows', 2)
    total_cells = rows * cols

    occupied_cells = set()
    for c in floating_clients:
        cells = map_window_to_cells(c, mon, cfg)
        for cell in cells:
            occupied_cells.add(cell)

    gaps = cfg.get('gaps', {})
    inner = gaps.get('inner', 8)
    outer = gaps.get('outer', 12)
    top_bar = gaps.get('top_bar', 35)

    mon_w = int(mon.get('width', 1920) / mon.get('scale', 1.0))
    mon_h = int(mon.get('height', 1080) / mon.get('scale', 1.0))
    mon_x = mon.get('x', 0)
    mon_y = mon.get('y', 0)

    canvas_x = mon_x + outer
    canvas_y = mon_y + top_bar + outer
    canvas_w = mon_w - (2 * outer)
    canvas_h = mon_h - top_bar - (2 * outer)

    col_weights = cfg.get('col_weights', [1.0] * cols)
    while len(col_weights) < cols:
        col_weights.append(1.0)
    col_weights = col_weights[:cols]

    row_weights = cfg.get('row_weights', [1.0] * rows)
    while len(row_weights) < rows:
        row_weights.append(1.0)
    row_weights = row_weights[:rows]

    # -------------------------------------------------------------
    # CASE 1: Grid has unoccupied gaps -> Fill the gap (RIGHT)
    # -------------------------------------------------------------
    if len(occupied_cells) < total_cells:
        unoccupied = []
        for r in range(rows):
            for c in range(cols):
                if (r, c) not in occupied_cells:
                    unoccupied.append((r, c))

        if unoccupied:
            min_r = min(r for r, c in unoccupied)
            max_r = max(r for r, c in unoccupied)
            min_c = min(c for r, c in unoccupied)
            max_c = max(c for r, c in unoccupied)

            target_x, target_w, _, _ = compute_dimension_coords(canvas_x, canvas_w, inner, col_weights, min_c, max_c)
            target_y, target_h, _, _ = compute_dimension_coords(canvas_y, canvas_h, inner, row_weights, min_r, max_r)

            script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{new_addr}' }})"
hyprctl dispatch "hl.dsp.window.float({{ action = 'on' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {target_w}, y = {target_h} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {target_x}, y = {target_y} }})"
'''
            subprocess.run(['bash', '-c', script], check=False)
            last_focused_window_addr = new_addr.lower()
            split_direction_history[new_addr.lower()] = 'right'
            return

    # -------------------------------------------------------------
    # CASE 2: Grid is ALREADY FULL -> Alternating Dwindle Split
    # Strict alternation: Right -> Bottom -> Right -> Bottom
    # -------------------------------------------------------------
    target_win = None
    if last_focused_window_addr:
        target_win = next((c for c in floating_clients if c.get('address', '').lower() == last_focused_window_addr.lower()), None)

    if not target_win:
        sorted_by_focus = sorted(floating_clients, key=lambda c: c.get('focusHistoryID', 999))
        target_win = sorted_by_focus[0] if sorted_by_focus else floating_clients[-1]

    t_addr = target_win.get('address')
    t_addr_lower = t_addr.lower()
    tx, ty = target_win.get('at', [0, 0])
    tw, th = target_win.get('size', [0, 0])

    # Determine split direction:
    last_dir = split_direction_history.get(t_addr_lower)
    if last_dir == 'right':
        chosen_dir = 'bottom'
    elif last_dir == 'bottom':
        chosen_dir = 'right'
    else:
        # Fallback ratio analysis
        if th >= 650:
            chosen_dir = 'bottom'
        elif tw >= 1000:
            chosen_dir = 'right'
        elif th >= 400:
            chosen_dir = 'bottom'
        else:
            chosen_dir = 'right'

    if chosen_dir == 'bottom':
        # Split BOTTOM (Top half for target, Bottom half for new)
        h1 = (th - inner) // 2
        h2 = th - inner - h1
        y2 = ty + h1 + inner

        script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{t_addr}' }})"
hyprctl dispatch "hl.dsp.window.float({{ action = 'on' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {tw}, y = {h1} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {tx}, y = {ty} }})"
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{new_addr}' }})"
hyprctl dispatch "hl.dsp.window.float({{ action = 'on' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {tw}, y = {h2} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {tx}, y = {y2} }})"
'''
        subprocess.run(['bash', '-c', script], check=False)
        split_direction_history[t_addr_lower] = 'bottom'
        split_direction_history[new_addr.lower()] = 'bottom'

    else:
        # Split RIGHT (Left half for target, Right half for new)
        w1 = (tw - inner) // 2
        w2 = tw - inner - w1
        x2 = tx + w1 + inner

        script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{t_addr}' }})"
hyprctl dispatch "hl.dsp.window.float({{ action = 'on' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {w1}, y = {th} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {tx}, y = {ty} }})"
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{new_addr}' }})"
hyprctl dispatch "hl.dsp.window.float({{ action = 'on' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {w2}, y = {th} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {x2}, y = {ty} }})"
'''
        subprocess.run(['bash', '-c', script], check=False)
        split_direction_history[t_addr_lower] = 'right'
        split_direction_history[new_addr.lower()] = 'right'

    last_focused_window_addr = new_addr.lower()


def handle_window_closed(closed_addr):
    """Universal sibling expansion on window close for ANY number of windows."""
    global split_direction_history
    cfg = load_config()
    clients, mon = get_active_clients_and_monitor()
    if not mon:
        return

    active_mon = next((m for m in [mon] if m.get('focused')), mon)
    active_ws_id = active_mon.get('activeWorkspace', {}).get('id')
    active_ws_name = str(active_mon.get('activeWorkspace', {}).get('name', ''))

    # Remaining floating windows on active workspace
    rem_floating = [c for c in clients if (c.get('workspace', {}).get('id') == active_ws_id or str(c.get('workspace', {}).get('name')) == active_ws_name) and c.get('floating') is True and not c.get('hidden') and c.get('mapped') and c.get('address', '').lower() != closed_addr.lower()]

    if not rem_floating:
        return

    gaps = cfg.get('gaps', {})
    inner = gaps.get('inner', 8)
    outer = gaps.get('outer', 12)
    top_bar = gaps.get('top_bar', 35)

    mon_w = int(mon.get('width', 1920) / mon.get('scale', 1.0))
    mon_h = int(mon.get('height', 1080) / mon.get('scale', 1.0))
    mon_x = mon.get('x', 0)
    mon_y = mon.get('y', 0)

    canvas_x = mon_x + outer
    canvas_y = mon_y + top_bar + outer
    canvas_w = mon_w - (2 * outer)
    canvas_h = mon_h - top_bar - (2 * outer)

    # 1. If only 1 window is left -> expand to 100% full screen canvas!
    if len(rem_floating) == 1:
        sole_addr = rem_floating[0].get('address')
        script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{sole_addr}' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {canvas_w}, y = {canvas_h} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {canvas_x}, y = {canvas_y} }})"
'''
        subprocess.run(['bash', '-c', script], check=False)
        split_direction_history[sole_addr.lower()] = 'right'
        return

    # 2. Universal Sibling Match using cached closed geometry
    cached_geo = last_known_geometry.get(closed_addr.lower())
    if cached_geo:
        xc, yc, wc, hc, _ = cached_geo

        # Try Horizontal Left Neighbor (Left expands Right to cover closed window)
        for win in rem_floating:
            wx, wy = win.get('at', [0, 0])
            ww, wh = win.get('size', [0, 0])
            target_addr = win.get('address')
            if abs((wx + ww + inner) - xc) <= 8 and abs(wy - yc) <= 15 and abs(wh - hc) <= 15:
                new_w = ww + inner + wc
                script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{target_addr}' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {new_w}, y = {wh} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {wx}, y = {wy} }})"
'''
                subprocess.run(['bash', '-c', script], check=False)
                split_direction_history[target_addr.lower()] = 'bottom'
                return

        # Try Horizontal Right Neighbor (Right expands Left to cover closed window)
        for win in rem_floating:
            wx, wy = win.get('at', [0, 0])
            ww, wh = win.get('size', [0, 0])
            target_addr = win.get('address')
            if abs((xc + wc + inner) - wx) <= 8 and abs(wy - yc) <= 15 and abs(wh - hc) <= 15:
                new_w = ww + inner + wc
                script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{target_addr}' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {new_w}, y = {wh} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {xc}, y = {wy} }})"
'''
                subprocess.run(['bash', '-c', script], check=False)
                split_direction_history[target_addr.lower()] = 'bottom'
                return

        # Try Vertical Top Neighbor (Top expands Down to cover closed window)
        for win in rem_floating:
            wx, wy = win.get('at', [0, 0])
            ww, wh = win.get('size', [0, 0])
            target_addr = win.get('address')
            if abs((wy + wh + inner) - yc) <= 8 and abs(wx - xc) <= 15 and abs(ww - wc) <= 15:
                new_h = wh + inner + hc
                script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{target_addr}' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {ww}, y = {new_h} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {wx}, y = {wy} }})"
'''
                subprocess.run(['bash', '-c', script], check=False)
                split_direction_history[target_addr.lower()] = 'right'
                return

        # Try Vertical Bottom Neighbor (Bottom expands Up to cover closed window)
        for win in rem_floating:
            wx, wy = win.get('at', [0, 0])
            ww, wh = win.get('size', [0, 0])
            target_addr = win.get('address')
            if abs((yc + hc + inner) - wy) <= 8 and abs(wx - xc) <= 15 and abs(ww - wc) <= 15:
                new_h = wh + inner + hc
                script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{target_addr}' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {ww}, y = {new_h} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {wx}, y = {yc} }})"
'''
                subprocess.run(['bash', '-c', script], check=False)
                split_direction_history[target_addr.lower()] = 'right'
                return

    # 3. Fallback: If 2 windows remain and no direct sibling matched, rebalance across active weights
    if len(rem_floating) == 2:
        grid = cfg.get('grid', {})
        cols = grid.get('cols', 3)
        col_weights = cfg.get('col_weights', [1.0] * cols)
        sorted_wins = sorted(rem_floating, key=lambda c: c.get('at', [0, 0])[0])
        w1_addr = sorted_wins[0].get('address')
        w2_addr = sorted_wins[1].get('address')

        w1_x, w1_w, _, _ = compute_dimension_coords(canvas_x, canvas_w, inner, col_weights, 0, 0)
        w2_x, w2_w, _, _ = compute_dimension_coords(canvas_x, canvas_w, inner, col_weights, 1, cols - 1)

        script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{w1_addr}' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {w1_w}, y = {canvas_h} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {w1_x}, y = {canvas_y} }})"
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{w2_addr}' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {w2_w}, y = {canvas_h} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {w2_x}, y = {canvas_y} }})"
'''
        subprocess.run(['bash', '-c', script], check=False)
        split_direction_history[w1_addr.lower()] = 'right'
        split_direction_history[w2_addr.lower()] = 'right'


def run_daemon():
    global last_focused_window_addr
    sock_path = get_hypr_socket2()
    if not sock_path:
        print("Hyprland socket2 not found.", file=sys.stderr)
        sys.exit(1)

    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        client.connect(sock_path)
    except Exception as e:
        print(f"Failed to connect to socket2: {e}", file=sys.stderr)
        sys.exit(1)

    get_active_clients_and_monitor()

    buffer = ""
    while True:
        try:
            data = client.recv(4096).decode('utf-8', errors='ignore')
            if not data:
                break
            buffer += data
            while "\n" in buffer:
                line, buffer = buffer.split("\n", 1)
                if line.startswith("activewindowv2>>"):
                    payload = line[len("activewindowv2>>"):].strip()
                    if payload and payload != "0" and payload != "0x0":
                        addr = "0x" + payload.lstrip("0x")
                        last_focused_window_addr = addr.lower()
                elif line.startswith("openwindow>>"):
                    payload = line[len("openwindow>>"):]
                    parts = payload.split(",")
                    if len(parts) >= 2:
                        addr = "0x" + parts[0].lstrip("0x")
                        ws = parts[1]
                        time.sleep(0.06)
                        autofill_new_window(addr, ws)
                        get_active_clients_and_monitor()
                elif line.startswith("closewindow>>"):
                    payload = line[len("closewindow>>"):]
                    closed_addr = "0x" + payload.strip().lstrip("0x")
                    time.sleep(0.06)
                    handle_window_closed(closed_addr)
                    get_active_clients_and_monitor()
        except Exception:
            time.sleep(0.5)


if __name__ == '__main__':
    run_daemon()
