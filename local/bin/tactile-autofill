#!/usr/bin/env python3
"""
Tactile Auto-Fill Daemon for Hyprland & Omarchy
Monitors Hyprland window creation events via socket2.
When a new window opens on a workspace where existing windows occupy
a Tactile sub-region (e.g. Left 2/3), it automatically snaps the new window
to fill the unoccupied grid area (e.g. Right 1/3).
"""

import sys
import os
import json
import socket
import subprocess
import time


def get_hypr_socket2():
    his = os.getenv('HYPRLAND_INSTANCE_SIGNATURE')
    if not his:
        return None
    
    runtime_dir = os.getenv('XDG_RUNTIME_DIR', f'/run/user/{os.getuid()}')
    path = os.path.join(runtime_dir, 'hypr', his, '.socket2.sock')
    return path if os.path.exists(path) else None


def load_config():
    config_paths = [
        os.path.expanduser('~/.config/tactile/config.json'),
        os.path.expanduser('~/dotfiles/config/tactile/config.json'),
    ]
    for p in config_paths:
        if os.path.isfile(p):
            try:
                with open(p, 'r') as f:
                    return json.load(f)
            except Exception:
                pass

    return {
        "gaps": { "outer": 12, "inner": 8, "top_bar": 35 },
        "grid": { "rows": 2, "cols": 3 }
    }


def get_active_clients_and_monitor():
    try:
        clients = json.loads(subprocess.check_output(['hyprctl', 'clients', '-j'], text=True))
        monitors = json.loads(subprocess.check_output(['hyprctl', 'monitors', '-j'], text=True))
        focused_mon = next((m for m in monitors if m.get('focused')), monitors[0] if monitors else None)
        return clients, focused_mon
    except Exception:
        return [], None


def map_window_to_cells(win, mon, cfg):
    """Determine which 2x3 grid cells a window currently occupies."""
    if not win or not mon:
        return []

    mon_w = mon.get('width', 1920)
    mon_h = mon.get('height', 1080)
    scale = mon.get('scale', 1.0)
    mon_x = mon.get('x', 0)
    mon_y = mon.get('y', 0)

    scaled_w = int(mon_w / scale)
    scaled_h = int(mon_h / scale)

    gaps = cfg.get('gaps', {})
    outer = gaps.get('outer', 12)
    inner = gaps.get('inner', 8)
    top_bar = gaps.get('top_bar', 35)

    canvas_x = mon_x + outer
    canvas_y = mon_y + top_bar + outer
    canvas_w = scaled_w - (2 * outer)
    canvas_h = scaled_h - top_bar - (2 * outer)

    cols = 3
    rows = 2
    cell_w = (canvas_w - ((cols - 1) * inner)) / cols
    cell_h = (canvas_h - ((rows - 1) * inner)) / rows

    win_at = win.get('at', [0, 0])
    win_size = win.get('size', [0, 0])
    wx, wy = win_at[0], win_at[1]
    ww, wh = win_size[0], win_size[1]

    occupied = []
    for r in range(rows):
        for c in range(cols):
            cx = canvas_x + c * (cell_w + inner)
            cy = canvas_y + r * (cell_h + inner)
            cw = cell_w
            ch = cell_h

            # Check overlap between window rect and cell rect
            overlap_x = max(0, min(wx + ww, cx + cw) - max(wx, cx))
            overlap_y = max(0, min(wy + wh, cy + ch) - max(wy, cy))
            
            # If overlap covers at least 30% of the cell
            if (overlap_x * overlap_y) > (0.30 * cw * ch):
                occupied.append((r, c))

    return occupied


def autofill_new_window(new_addr, workspace_id_or_name):
    cfg = load_config()
    clients, mon = get_active_clients_and_monitor()
    if not mon:
        return

    # Filter clients on the target workspace
    ws_str = str(workspace_id_or_name).strip()
    
    existing_clients = []
    for c in clients:
        c_addr = c.get('address', '').lower()
        if c_addr == new_addr.lower():
            continue
        c_ws_name = str(c.get('workspace', {}).get('name', ''))
        c_ws_id = str(c.get('workspace', {}).get('id', ''))
        
        if (c_ws_name == ws_str or c_ws_id == ws_str) and not c.get('hidden') and c.get('mapped'):
            existing_clients.append(c)

    if not existing_clients:
        return

    # Check which cells existing windows occupy
    occupied_cells = set()
    for c in existing_clients:
        cells = map_window_to_cells(c, mon, cfg)
        for cell in cells:
            occupied_cells.add(cell)

    # Only auto-fill if there are occupied cells AND there are empty cells left
    if not occupied_cells or len(occupied_cells) >= 6:
        return

    # Find all unoccupied cells
    unoccupied = []
    for r in range(2):
        for c in range(3):
            if (r, c) not in occupied_cells:
                unoccupied.append((r, c))

    if not unoccupied:
        return

    # Calculate bounding box spanning unoccupied cells
    min_r = min(r for r, c in unoccupied)
    max_r = max(r for r, c in unoccupied)
    min_c = min(c for r, c in unoccupied)
    max_c = max(c for r, c in unoccupied)

    mon_w = mon.get('width', 1920)
    mon_h = mon.get('height', 1080)
    scale = mon.get('scale', 1.0)
    mon_x = mon.get('x', 0)
    mon_y = mon.get('y', 0)

    scaled_w = int(mon_w / scale)
    scaled_h = int(mon_h / scale)

    gaps = cfg.get('gaps', {})
    outer = gaps.get('outer', 12)
    inner = gaps.get('inner', 8)
    top_bar = gaps.get('top_bar', 35)

    canvas_x = mon_x + outer
    canvas_y = mon_y + top_bar + outer
    canvas_w = scaled_w - (2 * outer)
    canvas_h = scaled_h - top_bar - (2 * outer)

    cols = 3
    rows = 2
    cell_w = (canvas_w - ((cols - 1) * inner)) / cols
    cell_h = (canvas_h - ((rows - 1) * inner)) / rows

    target_x = int(canvas_x + min_c * (cell_w + inner))
    target_y = int(canvas_y + min_r * (cell_h + inner))

    span_cols = (max_c - min_c + 1)
    span_rows = (max_r - min_r + 1)

    target_w = int(span_cols * cell_w + (span_cols - 1) * inner)
    target_h = int(span_rows * cell_h + (span_rows - 1) * inner)

    # Dispatch positioning for new window
    script = f'''
hyprctl dispatch "hl.dsp.focus({{ window = 'address:{new_addr}' }})"
hyprctl dispatch "hl.dsp.window.float({{ action = 'on' }})"
hyprctl dispatch "hl.dsp.window.resize({{ x = {target_w}, y = {target_h} }})"
hyprctl dispatch "hl.dsp.window.move({{ x = {target_x}, y = {target_y} }})"
'''

    subprocess.run(['bash', '-c', script], check=False)


def run_daemon():
    sock_path = get_hypr_socket2()
    if not sock_path:
        print("Hyprland socket2 not found.", file=sys.stderr)
        sys.exit(1)

    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    try:
        client.connect(sock_path)
    except Exception as e:
        print(f"Failed to connect to socket2: {e}", file=sys.stderr)
        sys.exit(1)

    buffer = ""
    while True:
        try:
            data = client.recv(4096).decode('utf-8', errors='ignore')
            if not data:
                break
            buffer += data
            while "\n" in buffer:
                line, buffer = buffer.split("\n", 1)
                if line.startswith("openwindow>>"):
                    # Format: openwindow>>[address],[workspace],[class],[title]
                    payload = line[len("openwindow>>"):]
                    parts = payload.split(",")
                    if len(parts) >= 2:
                        addr = "0x" + parts[0].lstrip("0x")
                        ws = parts[1]
                        # Grace delay for window to map in clients list
                        time.sleep(0.06)
                        autofill_new_window(addr, ws)
        except Exception:
            time.sleep(0.5)


if __name__ == '__main__':
    run_daemon()
