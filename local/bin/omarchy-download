#!/bin/bash
# Omarchy Turbo Downloader (aria2c + yt-dlp)
# Fast, multi-connection, clipboard-aware downloader for files and streaming media (including Bilibili, YouTube, TikTok, etc.).
# Usage: omarchy-download [URL]

set -euo pipefail

DOWNLOAD_DIR="${XDG_DOWNLOAD_DIR:-$HOME/Downloads}"
mkdir -p "$DOWNLOAD_DIR"

# 1. Header Display
clear
gum style \
  --foreground 212 --border-foreground 99 --border double \
  --align center --width 60 --margin "1 0" --padding "1 2" \
  "🚀 Omarchy Turbo Downloader" "aria2c (16x Multi-Stream) + yt-dlp"

# 2. Get URL (inspect clipboard or use argument)
INPUT_URL="${1:-}"
if [[ -z "$INPUT_URL" ]]; then
  CLIP=$(wl-paste 2>/dev/null | tr -d '\r\n' || true)
  if [[ "$CLIP" =~ ^https?:// ]] || [[ "$CLIP" =~ ^ftp:// ]] || [[ "$CLIP" =~ ^magnet:\? ]]; then
    INPUT_URL="$CLIP"
  fi
fi

echo "Enter or paste your download URL below:"
URL=$(gum input --placeholder "https://... (YouTube, Bilibili, TikTok, Direct ISO/ZIP, Magnet...)" --value "$INPUT_URL")

if [[ -z "$URL" ]]; then
  gum style --foreground 214 "⚠️ No URL provided. Exiting..."
  exit 0
fi

# 3. Detect Media Platform vs Direct File
IS_MEDIA=0
IS_BILIBILI=0

if [[ "$URL" =~ (bilibili\.com|b23\.tv|bilibili\.tv) ]]; then
  IS_MEDIA=1
  IS_BILIBILI=1
elif [[ "$URL" =~ (youtube\.com|youtu\.be|tiktok\.com|twitter\.com|x\.com|instagram\.com|reddit\.com|twitch\.tv|kick\.com|vimeo\.com|soundcloud\.com|fb\.watch|facebook\.com|dailymotion\.com|loom\.com|bandcamp\.com|mixcloud\.com) ]]; then
  IS_MEDIA=1
fi

MODE="direct"

if [[ $IS_MEDIA -eq 1 ]]; then
  echo ""
  if [[ $IS_BILIBILI -eq 1 ]]; then
    gum style --foreground 117 "📺 Bilibili (B站) video detected!"
  else
    gum style --foreground 117 "🎬 Media platform detected! Select format:"
  fi

  MODE=$(gum choose \
    "🎬 Best Video (Highest Quality + aria2c 16x)" \
    "🎵 Audio Only (MP3 + Cover Art & Metadata)" \
    "📺 1080p Video (Balanced Size + aria2c 16x)" \
    "⚡ Direct Raw Download (aria2c)")
fi

echo ""
gum style --foreground 86 "📁 Target Directory: $DOWNLOAD_DIR"
echo ""

# 4. Configure Bilibili-Specific Headers (fixes 403 Forbidden on CDN chunks)
CUSTOM_HEADERS=()
ARIA2C_HEADERS=""

if [[ $IS_BILIBILI -eq 1 ]]; then
  CUSTOM_HEADERS+=(
    --add-header "Referer:https://www.bilibili.com"
    --add-header "User-Agent:Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/130.0.0.0 Safari/537.36"
  )
  ARIA2C_HEADERS="--header='Referer: https://www.bilibili.com' --header='User-Agent: Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36'"
fi

# 5. Execute Download
cd "$DOWNLOAD_DIR"
START_TIME=$(date +%s)

COMMON_YTDL_ARGS=(
  --no-mtime
  --progress
  --embed-thumbnail
  --embed-metadata
  --embed-chapters
  --concurrent-fragments 4
)

case "$MODE" in
  *"Audio Only"*)
    gum style --foreground 120 "🎵 Downloading and extracting audio (MP3 + Tags)..."
    yt-dlp \
      "${CUSTOM_HEADERS[@]}" \
      "${COMMON_YTDL_ARGS[@]}" \
      --downloader aria2c \
      --downloader-args "aria2c:$ARIA2C_HEADERS -s 16 -x 16 -k 1M -j 4" \
      --extract-audio \
      --audio-format mp3 \
      --audio-quality 0 \
      "$URL" || {
        echo "⚠️ aria2c encountered strict CDN rules. Retrying with native stream..."
        yt-dlp "${CUSTOM_HEADERS[@]}" "${COMMON_YTDL_ARGS[@]}" --extract-audio --audio-format mp3 --audio-quality 0 "$URL"
      }
    ;;

  *"1080p Video"*)
    gum style --foreground 120 "📺 Downloading 1080p Video with aria2c acceleration..."
    yt-dlp \
      "${CUSTOM_HEADERS[@]}" \
      "${COMMON_YTDL_ARGS[@]}" \
      --downloader aria2c \
      --downloader-args "aria2c:$ARIA2C_HEADERS -s 16 -x 16 -k 1M -j 4" \
      -f "bestvideo[height<=1080]+bestaudio/best[height<=1080]" \
      --merge-output-format mp4 \
      "$URL" || {
        echo "⚠️ Retrying with native multi-stream..."
        yt-dlp "${CUSTOM_HEADERS[@]}" "${COMMON_YTDL_ARGS[@]}" -f "bestvideo[height<=1080]+bestaudio/best[height<=1080]" --merge-output-format mp4 "$URL"
      }
    ;;

  *"Best Video"*)
    gum style --foreground 120 "🎬 Downloading Best Video with aria2c acceleration..."
    yt-dlp \
      "${CUSTOM_HEADERS[@]}" \
      "${COMMON_YTDL_ARGS[@]}" \
      --downloader aria2c \
      --downloader-args "aria2c:$ARIA2C_HEADERS -s 16 -x 16 -k 1M -j 4" \
      --merge-output-format mp4 \
      "$URL" || {
        echo "⚠️ Retrying with native multi-stream..."
        yt-dlp "${CUSTOM_HEADERS[@]}" "${COMMON_YTDL_ARGS[@]}" --merge-output-format mp4 "$URL"
      }
    ;;

  *)
    gum style --foreground 120 "⚡ Downloading via aria2c (16 parallel connections)..."
    aria2c \
      --dir="$DOWNLOAD_DIR" \
      --max-connection-per-server=16 \
      --split=16 \
      --min-split-size=1M \
      --max-concurrent-downloads=4 \
      --continue=true \
      --auto-file-renaming=true \
      --summary-interval=1 \
      --console-log-level=notice \
      --download-result=full \
      --seed-time=0 \
      "$URL"
    ;;
esac

DURATION=$(( $(date +%s) - START_TIME ))

# 6. Desktop Notification
notify-send \
  -i folder-download \
  -a "Omarchy Downloader" \
  "Download Complete! 🚀" \
  "Finished in ${DURATION}s. Saved to ~/Downloads." \
  2>/dev/null || true

echo ""
gum style \
  --foreground 120 --border-foreground 120 --border rounded \
  --padding "0 2" --margin "1 0" \
  "✅ Download Complete (${DURATION}s)!" "Saved to: $DOWNLOAD_DIR"

# 7. Post-Download Action
echo "What would you like to do next?"
ACTION=$(gum choose \
  "📁 Open in Files (Nautilus)" \
  "🎬 Open Latest Download in Default App" \
  "📋 Copy Downloads Path" \
  "🚪 Exit")

case "$ACTION" in
  *"Open in Files"*)
    nautilus "$DOWNLOAD_DIR" >/dev/null 2>&1 &
    ;;
  *"Open Latest"*)
    LATEST=$(ls -t "$DOWNLOAD_DIR" | head -n 1)
    if [[ -n "$LATEST" ]]; then
      xdg-open "$DOWNLOAD_DIR/$LATEST" >/dev/null 2>&1 &
    fi
    ;;
  *"Copy Downloads"*)
    echo -n "$DOWNLOAD_DIR" | wl-copy 2>/dev/null || true
    gum style --foreground 86 "Copied '$DOWNLOAD_DIR' to clipboard!"
    sleep 1
    ;;
  *)
    exit 0
    ;;
esac
