{
  "setup.default.agent.agy": {
    "icon": "󱚤",
    "label": "Antigravity (agy)",
    "checked": "[[ \"$(omarchy-default-agent)\" == \"agy\" ]]",
    "action": "omarchy-default-agent agy"
  },
  "install.ai.antigravity": {
    "icon": "󱚤",
    "label": "Antigravity CLI",
    "when": "! omarchy-cmd-present agy",
    "action": "omarchy-launch-floating-terminal-with-presentation 'curl -fsSL https://antigravity.google.com/install.sh | bash'"
  },
  "setup.default.kernel": {
    "icon": "󰌽",
    "label": "Kernel",
    "title": "Default Boot Kernel"
  },
  "setup.default.kernel.cachyos": {
    "icon": "󰌽",
    "label": "CachyOS (BORE)",
    "when": "omarchy-pkg-present linux-cachyos",
    "checked": "[[ \"$(omarchy-default-kernel)\" == \"cachyos\" ]]",
    "action": "omarchy-launch-floating-terminal-with-presentation 'omarchy-default-kernel cachyos'"
  },
  "setup.default.kernel.stock": {
    "icon": "󰌽",
    "label": "Arch Linux (Stock)",
    "when": "omarchy-pkg-present linux",
    "checked": "[[ \"$(omarchy-default-kernel)\" == \"stock\" ]]",
    "action": "omarchy-launch-floating-terminal-with-presentation 'omarchy-default-kernel stock'"
  },
  "setup.battery-boost": {
    "icon": "",
    "label": "Unlock Battery Turbo Boost (RyzenAdj)",
    "action": "omarchy-launch-floating-terminal-with-presentation 'sudo bash $HOME/dotfiles/scripts/setup-ryzenadj.sh'"
  }
}
